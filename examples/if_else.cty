// Definicja zmiennych sterujących
let includeR1 = true;
let includeR2 = false;

// Jeśli includeR1 == true, wstaw rezystor R1, inaczej R1_pom (np. większy rezystor)
if (includeR1) {
    print("Wstawiam R1");
    R R1 = 100 : N, GND;
} else {
    print("Wstawiam R1_pom");
    R R1_pom = 1000 : N, GND;
}

// Druga instrukcja if-else: jeśli includeR2, wstaw R2, w przeciwnym razie nic lub inny element
if (includeR2) {
    print("Wstawiam R2");
    R R2 = 200 : N, GND;
} else {
    print("Nie wstawiam R2, wstawiam R3");
    R R3 = 300 : N, GND;
}

// Przykład zagnieżdżonego if
let useSeries = false;
if (includeR1) {
    if (useSeries) {
        print("Wstawiam szeregowo R4 i R5");
        // przykładowo: R4 szeregowo z R5 — ale tu w DSL same pojedyncze wpisy
        R R4 = 400 : N, GND;
        R R5 = 500 : N, GND;
    } else {
        print("Wstawiam tylko R6");
        R R6 = 600 : N, GND;
    }
}

// Źródło napięcia
V V1 = 10 : N, GND;

// Blok symulacji DC (przykład składni dc();)
dc();

